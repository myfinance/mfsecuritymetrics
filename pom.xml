<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.hf.myfinance.mfsecuritymetrics</groupId>
    <artifactId>mfsecuritymetrics</artifactId>
    <version>0.0.0-0-SNAPSHOT</version>
    <name>MFSecurityMetrics</name>
    <parent>
		<groupId>de.hf.myfinance</groupId>
		<artifactId>root</artifactId>
        <version>0.24.0-alpha-1d884df9ba9239f2baa83536391fd8dece6814e2</version>
		<relativePath/> 
	</parent>
    <properties>
        <NEXUS_URL>192.168.100.73:31001</NEXUS_URL>
        <MFFrameWork.Version>0.24.0-alpha-1d884df9ba9239f2baa83536391fd8dece6814e2</MFFrameWork.Version>
       <jib.container-name>holgerfischer/myfinance-mfsecuritymetrics:</jib.container-name>
   </properties>

   <dependencies>
        <dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
       <dependency>
           <groupId>org.springdoc</groupId>
           <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
           <version>${openapistarter.version}</version>
       </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-rabbit</artifactId>
        </dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
       <dependency>
           <groupId>org.springframework.cloud</groupId>
           <artifactId>spring-cloud-stream-test-binder</artifactId>
           <scope>test</scope>
       </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--list helper-->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <dependency>
			<groupId>de.hf.myfinance</groupId>
			<artifactId>mfframework</artifactId>
            <version>${MFFrameWork.Version}</version>
		</dependency>

        <dependency>
			<groupId>de.hf.myfinance</groupId>
			<artifactId>mfapi</artifactId>
            <version>${MFFrameWork.Version}</version>
		</dependency>

       <dependency>
           <groupId>de.hf.myfinance</groupId>
           <artifactId>testhelper</artifactId>
           <scope>test</scope>
           <version>${MFFrameWork.Version}</version>
       </dependency>
	</dependencies>

    <build>
        <plugins>
        	<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>
                <configuration>
                <from>
                    <image>${jib.baseimage}</image>
                </from>
                <to>
                    <image>${jib.container-repo}${jib.container-name}${project.version}</image>
                </to>
                <container>
                    <mainClass>de.hf.myfinance.securitymetrics.SecurityMetricsServiceApplication</mainClass>
                </container>
                <allowInsecureRegistries>true</allowInsecureRegistries>
                </configuration>
            </plugin>            
        </plugins>
    </build>

    <repositories>
     <repository>
      <id>mynexus-release</id>
      <name>mynexus release</name>
      <url>http://192.168.100.73:31001/repository/maven-releases/</url>
      <releases>
       <enabled>true</enabled>
      </releases>
      <snapshots>
       <enabled>false</enabled>
      </snapshots>
     </repository>     
   </repositories>

</project> 